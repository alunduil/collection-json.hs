{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "security:openssf-scorecard",
    "customManagers:githubActionsVersions",
    ":semanticCommitScopeDisabled"
  ],
  // Titles follow the pull request title convention in CONTRIBUTING.md.
  // `auto` would infer it from recent history, and the default lowercasing
  // would break the capitalised subject.
  "semanticCommits": "enabled",
  "commitMessageLowerCase": "never",
  "timezone": "Europe/London",
  "reviewers": [
    "alunduil"
  ],
  // The Daily workflow exempts this label from stale closing.
  "labels": [
    "dependencies"
  ],
  "minimumReleaseAge": "3 days",
  // hackage reports no release timestamps, so the default
  // timestamp-required mode holds every cabal update forever rather than
  // for three days. Datasources that do report them keep the full bake.
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "packageRules": [
    {
      "matchUpdateTypes": [
        "pin",
        "pinDigest",
        "digest",
        "lockFileMaintenance",
        "lockfileUpdate",
        "rollback",
        "bump",
        "replacement"
      ],
      "minimumReleaseAge": null
    },
    // Cabal bounds ship in the Hackage package, so moving one is a change
    // downstream sees. Test-suite bounds count too: packagers run the tests.
    {
      "matchManagers": [
        "haskell-cabal"
      ],
      "semanticCommitType": "change"
    }
  ],
  "osvVulnerabilityAlerts": true,
  "pre-commit": {
    "enabled": true
  }
}
