{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "security:openssf-scorecard",
    "customManagers:githubActionsVersions"
  ],
  "timezone": "Europe/London",
  "reviewers": [
    "alunduil"
  ],
  "minimumReleaseAge": "3 days",
  // hackage reports no release timestamps, so the default
  // timestamp-required mode holds every cabal update forever rather than
  // for three days. Datasources that do report them keep the full bake.
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "packageRules": [
    {
      "matchUpdateTypes": [
        "pin",
        "pinDigest",
        "digest",
        "lockFileMaintenance",
        "lockfileUpdate",
        "rollback",
        "bump",
        "replacement"
      ],
      "minimumReleaseAge": null
    }
  ],
  "customManagers": [
    {
      // The github-actions manager skips `runs-on:` expressions, so runner
      // labels in a job matrix need their own manager.
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStringsStrategy": "recursive",
      "matchStrings": [
        "\\brunner:\\s*\\[[^\\]]*\\]",
        "(?<depName>[a-zA-Z]+)-(?<currentValue>[\\w.-]+)"
      ],
      "datasourceTemplate": "github-runners",
      "versioningTemplate": "docker",
      "depTypeTemplate": "github-runner"
    }
  ],
  "osvVulnerabilityAlerts": true,
  "pre-commit": {
    "enabled": true
  }
}
