{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>alunduil/renovate-config",
    "github>alunduil/renovate-config:automerge-minor",
    "github>alunduil/renovate-config:hold-release-tool(ghc/ghc)",
    "github>alunduil/renovate-config:haskell",
    ":semanticCommits",
    ":semanticCommitScopeDisabled"
  ],
  // The title convention in CONTRIBUTING.md starts subjects with a capital
  // that the default lowercasing would drop.
  "commitMessageLowerCase": "never",
  // The Daily workflow exempts this label from stale closing.
  "labels": [
    "dependencies"
  ],
  // Hackage reports no release timestamps, so without this every cabal
  // update waits out the bake forever. Datasources that report timestamps
  // keep the full bake.
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "packageRules": [
    {
      "description": "Cabal bounds ship in the Hackage package, so moving one is a change downstream sees. Test-suite bounds count too: packagers run the tests.",
      "matchManagers": [
        "haskell-cabal"
      ],
      "semanticCommitType": "change"
    },
    {
      "description": "Default versioning never offers four-component PVP versions, and release tags carry a v that mise.toml omits.",
      "matchManagers": [
        "mise"
      ],
      "matchPackageNames": [
        "fourmolu/fourmolu",
        "ndmitchell/hlint"
      ],
      "versioning": "loose",
      "extractVersion": "^v(?<version>.+)$"
    }
  ]
}
