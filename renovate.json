{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>alunduil/renovate-config",
    ":semanticCommits",
    ":semanticCommitScopeDisabled"
  ],
  // The title convention in CONTRIBUTING.md starts subjects with a capital
  // that the default lowercasing would drop.
  "commitMessageLowerCase": "never",
  // The Daily workflow exempts this label from stale closing.
  "labels": [
    "dependencies"
  ],
  // Hackage reports no release timestamps, so without this every cabal
  // update waits out the bake forever. Datasources that report timestamps
  // keep the full bake.
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "packageRules": [
    {
      "description": "Cabal bounds ship in the Hackage package, so moving one is a change downstream sees. Test-suite bounds count too: packagers run the tests.",
      "matchManagers": [
        "haskell-cabal"
      ],
      "semanticCommitType": "change"
    },
    {
      "description": "GHC can't link on macos-26: https://github.com/actions/runner-images/issues/14940",
      "matchDatasources": [
        "github-runners"
      ],
      "matchPackageNames": [
        "macos"
      ],
      "allowedVersions": "<26"
    }
  ]
}
