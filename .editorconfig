root = true

# The whitespace and line-ending settings pair with the pre-commit hooks
# that enforce them after the fact (mixed-line-ending, trailing-whitespace,
# end-of-file-fixer); changing one side means changing the other.
[*]
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = space
indent_size = 2
